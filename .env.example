# Copia este archivo como .env en local o configura estas variables en tu servidor (Render / Railway)
# NUNCA subas el archivo .env real a GitHub

# Cadena de conexión de MongoDB Atlas (Atlas > Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/

# Base de datos en MongoDB Atlas
MONGODB_DB=hotel_hgi

# Puerto del servidor (Render/Railway lo asignan automáticamente con PORT)
PORT=3000

# Duración de la sesión en horas
SESION_HORAS=8

# Intentos fallidos antes de bloquear la cuenta y minutos de bloqueo
MAX_INTENTOS=5
MINUTOS_BLOQUEO=15

# Usa production cuando publiques la app con HTTPS
NODE_ENV=production
